{
  "manifest_version": 3,
  "name": "Ctrl-Q",
  "version": "1.0.0",
  "description": "Press Ctrl+Q to jump back to the tab you were just on.",
  "minimum_chrome_version": "116",

  "permissions": ["tabs", "storage"],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "commands": {
    "switch-last-tab": {
      "suggested_key": { "default": "Ctrl+Q", "mac": "MacCtrl+Q" },
      "description": "Switch to the last used tab"
    }
  }
}
